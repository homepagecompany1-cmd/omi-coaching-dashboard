# ===== NextAuth =====
# 本番URLを入れる（開発時は http://localhost:3000）
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32 などで生成
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_32BYTES_BASE64

# ===== Google OAuth =====
# https://console.cloud.google.com/apis/credentials で「ウェブアプリケーション」を作成
# 承認済みリダイレクトURI: http://localhost:3000/api/auth/callback/google
#                        https://<本番ドメイン>/api/auth/callback/google
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# ===== バックエンドWorker =====
# omi-coaching-worker がデプロイされたURL
WORKER_API_URL=https://omi-coaching-worker.YOUR_SUBDOMAIN.workers.dev

# ===== 必須: Worker内部API呼び出し用の共有シークレット =====
# dashboard -> worker の認証に使用。fail-close のため本番では必須。
# 生成例: openssl rand -hex 32
WORKER_INTERNAL_SECRET=REPLACE_WITH_RANDOM_HEX_64

# ===== 任意: Stripe 成功リダイレクトで許可する origin (カンマ区切り) =====
# 複数ドメインを使う場合のみ設定。未設定時は NEXTAUTH_URL のみ許可。
# ALLOWED_ORIGINS=https://dashboard.example.com,https://app.example.com
